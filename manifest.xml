<!--
    RepFlow — Connect IQ application manifest.

    IMPORTANT: the application `id` (UUID) must NEVER change once RepFlow has been
    published to the Connect IQ Store. Changing it creates a brand new store listing
    and orphans every existing installation. See docs/SIGNING.md.

    The product list below is generated from the *installed* Connect IQ SDK device
    definitions — run `make devices` to list what is available locally, and
    `scripts/sync-products.sh` to regenerate this block. Do not hand-invent product ids.
-->
<iq:manifest version="3" xmlns:iq="http://www.garmin.com/xml/connectiq">
    <iq:application
        id="289C529B638645F0B9A7334DF736972B"
        type="watch-app"
        name="@Strings.AppName"
        entry="RepFlowApp"
        launcherIcon="@Drawables.LauncherIcon"
        minApiLevel="3.1.0"
        version="1.0.0">

        <iq:products>
            <!-- Primary targets: current-generation Fenix 9 Pro -->
            <iq:product id="fenix9pro47mm"/>
            <iq:product id="fenix9pro51mm"/>
            <iq:product id="fenix9pro43mm"/>
            <iq:product id="fenix9prosolar47mm"/>
            <iq:product id="fenix9prosolar51mm"/>
            <iq:product id="fenix947mm"/>
            <iq:product id="fenix943mm"/>
            <!-- Fenix 8 family -->
            <iq:product id="fenix8pro47mm"/>
            <iq:product id="fenix847mm"/>
            <iq:product id="fenix843mm"/>
            <iq:product id="fenix8solar47mm"/>
            <iq:product id="fenix8solar51mm"/>
            <!-- Fenix 7 family -->
            <iq:product id="fenix7"/>
            <iq:product id="fenix7pro"/>
            <iq:product id="fenix7pronowifi"/>
            <iq:product id="fenix7s"/>
            <iq:product id="fenix7spro"/>
            <iq:product id="fenix7x"/>
            <iq:product id="fenix7xpro"/>
            <iq:product id="fenix7xpronowifi"/>
            <!-- Secondary target: the developer's own watch -->
            <iq:product id="fenix6pro"/>
            <iq:product id="fenix6xpro"/>
            <iq:product id="fenix6spro"/>
            <iq:product id="fenix6"/>
            <iq:product id="fenix6s"/>
            <!-- epix 2 family: same button-first UX model -->
            <iq:product id="epix2"/>
            <iq:product id="epix2pro42mm"/>
            <iq:product id="epix2pro47mm"/>
            <iq:product id="epix2pro51mm"/>
            <!-- Touch-first wearables; buttons still drive everything -->
            <iq:product id="venu3"/>
            <iq:product id="venu3s"/>
            <iq:product id="vivoactive5"/>
            <iq:product id="vivoactive6"/>
        </iq:products>

        <iq:permissions>
            <!-- Required to create and save an ActivityRecording session (FIT file). -->
            <iq:uses-permission id="Fit"/>
            <!-- Developer FIT fields: total sets, reps and training volume. -->
            <iq:uses-permission id="FitContributor"/>
            <!-- Heart rate zone thresholds, for the zone gauge. Without this the
                 gauge would have to guess a maximum heart rate, which would be
                 inventing data rather than reading it. -->
            <iq:uses-permission id="UserProfile"/>
            <!-- Body Battery, read at the start and end of a workout for the
                 recap. Garmin's own number: RepFlow reads it, never estimates. -->
            <iq:uses-permission id="SensorHistory"/>
            <!-- Raw accelerometer, for counting repetitions from the wrist.
                 Registered only while the set screen is showing, and only when
                 the athlete has switched it on: 25 Hz costs battery. -->
            <iq:uses-permission id="Sensor"/>
            <!-- The Hevy API: importing routines and logging finished workouts.
                 Every request is proxied through Garmin Connect Mobile, so it
                 only works with the phone in Bluetooth range. -->
            <iq:uses-permission id="Communications"/>
        </iq:permissions>

        <iq:languages>
            <iq:language>eng</iq:language>
            <iq:language>fre</iq:language>
        </iq:languages>

        <iq:barrels/>
    </iq:application>
</iq:manifest>
