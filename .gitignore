# Build output
build/
bin/
*.prg
*.prg.debug.xml
*.iq
*.png.mss

# Developer signing keys — NEVER commit these
*.der
*.pem
*.key
*.p12
*.pfx
developer_key*
keys/
.keys/

# OS / editor
.DS_Store
.vscode/settings.json
.idea/

# Local environment
.env
.env.local
scripts/.env

# Backend virtualenv and build artefacts. The Garmin session token lives in
# ~/.garminconnect, outside the repo, and must never be committed either.
backend/.venv/
backend/*.egg-info/
backend/**/__pycache__/

# Local secrets — a Hevy API key is read+write over a whole training history
secrets/*
!secrets/README.md
