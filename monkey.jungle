# 60x60
epix2.resourcePath = $(epix2.resourcePath);resources/icons/60
epix2pro42mm.resourcePath = $(epix2pro42mm.resourcePath);resources/icons/60
epix2pro47mm.resourcePath = $(epix2pro47mm.resourcePath);resources/icons/60
epix2pro51mm.resourcePath = $(epix2pro51mm.resourcePath);resources/icons/60
fenix843mm.resourcePath = $(fenix843mm.resourcePath);resources/icons/60
