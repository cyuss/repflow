project.manifest = manifest.xml

# Domain, engine and UI.
base.sourcePath = source

# Unit tests live beside the source so the Run No Evil test runner can find
# them. They are annotated (:test) and only enter the binary with 'monkeyc -t',
# so they cost nothing in a normal or release build.
base.sourcePath = source;tests

# Shared resources: strings, and the fallback launcher icon.
base.resourcePath = resources

# Launcher icons are a different pixel size on almost every product, and a
# mismatch makes the compiler rescale the bitmap (with a warning) instead of
# using a crisp one. Each device below points at the resource folder holding
# the icon already rendered at its exact size.
#
# GENERATED by scripts/make-icons.sh — re-run it after changing the product
# list in manifest.xml.

# 40x40
fenix6.resourcePath = $(fenix6.resourcePath);resources/icons/40
fenix6pro.resourcePath = $(fenix6pro.resourcePath);resources/icons/40
fenix6s.resourcePath = $(fenix6s.resourcePath);resources/icons/40
fenix6spro.resourcePath = $(fenix6spro.resourcePath);resources/icons/40
fenix6xpro.resourcePath = $(fenix6xpro.resourcePath);resources/icons/40
fenix7.resourcePath = $(fenix7.resourcePath);resources/icons/40
fenix7pro.resourcePath = $(fenix7pro.resourcePath);resources/icons/40
fenix7pronowifi.resourcePath = $(fenix7pronowifi.resourcePath);resources/icons/40
fenix7s.resourcePath = $(fenix7s.resourcePath);resources/icons/40
fenix7spro.resourcePath = $(fenix7spro.resourcePath);resources/icons/40
fenix7x.resourcePath = $(fenix7x.resourcePath);resources/icons/40
fenix7xpro.resourcePath = $(fenix7xpro.resourcePath);resources/icons/40
fenix7xpronowifi.resourcePath = $(fenix7xpronowifi.resourcePath);resources/icons/40
fenix8solar47mm.resourcePath = $(fenix8solar47mm.resourcePath);resources/icons/40
fenix8solar51mm.resourcePath = $(fenix8solar51mm.resourcePath);resources/icons/40
fenix9prosolar47mm.resourcePath = $(fenix9prosolar47mm.resourcePath);resources/icons/40
fenix9prosolar51mm.resourcePath = $(fenix9prosolar51mm.resourcePath);resources/icons/40

# 54x54
vivoactive6.resourcePath = $(vivoactive6.resourcePath);resources/icons/54

# 56x56
